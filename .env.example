DISCORD_TOKEN=your-discord-bot-token
# Optional: set to a guild ID for instant slash-command sync during testing.
# Leave blank to sync globally (can take up to an hour the first time).
GUILD_ID=

# Sonarr must be reachable from wherever this bot container runs.
# Use the NAS LAN IP if Sonarr isn't on the same docker network as this bot.
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=your-sonarr-api-key

# Radarr must be reachable from wherever this bot container runs.
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=your-radarr-api-key

# Auto-cleanup: every message in this channel older than CLEANUP_MAX_AGE_HOURS
# gets deleted on a recurring sweep. Requires the bot to have Manage Messages
# in that channel.
CLEANUP_CHANNEL_ID=your-channel-id
CLEANUP_MAX_AGE_HOURS=6
